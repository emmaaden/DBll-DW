  <MdxScripts>
    <MdxScript dwd:design-time-name="ff210b03-9a1e-4278-ade4-f507d7de1e36">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; CREATE MEMBER CURRENTCUBE.[Measures].[Turnos Cerrados]
 AS [Measures].[Turnos Atendidos] + [Measures].[Turnos Cancelados] + [Measures].[Turnos Ausentes],
FORMAT_STRING = "#,##0",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Asistencia]
 AS IIF([Measures].[Turnos Cerrados] = 0, NULL,
        [Measures].[Turnos Atendidos] / [Measures].[Turnos Cerrados]),
FORMAT_STRING = "0.0%",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Ausentismo]
 AS IIF([Measures].[Turnos Cerrados] = 0, NULL,
        [Measures].[Turnos Ausentes] / [Measures].[Turnos Cerrados]),
FORMAT_STRING = "0.0%",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Cancelacion]
 AS IIF([Measures].[Turnos Cerrados] = 0, NULL,
        [Measures].[Turnos Cancelados] / [Measures].[Turnos Cerrados]),
FORMAT_STRING = "0.0%",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

CREATE MEMBER CURRENTCUBE.[Measures].[Edad Promedio]
 AS IIF([Measures].[Cantidad Turnos] = 0, NULL,
        [Measures].[Suma Edad] / [Measures].[Cantidad Turnos]),
FORMAT_STRING = "0.0",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

-- Mismo periodo del año anterior (funciona a nivel Año, Trimestre o Mes)
CREATE MEMBER CURRENTCUBE.[Measures].[Turnos Año Anterior]
 AS ([Measures].[Cantidad Turnos],
     ParallelPeriod([Tiempo].[Calendario].[Año], 1, [Tiempo].[Calendario].CurrentMember)),
FORMAT_STRING = "#,##0",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';

CREATE MEMBER CURRENTCUBE.[Measures].[Variacion Interanual]
 AS IIF([Measures].[Turnos Año Anterior] = 0 OR [Measures].[Cantidad Turnos] = 0, NULL,
        ([Measures].[Cantidad Turnos] - [Measures].[Turnos Año Anterior])
        / [Measures].[Turnos Año Anterior]),
FORMAT_STRING = "0.0%",
VISIBLE = 1, DISPLAY_FOLDER = 'Indicadores';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="4c9720bd-ffd1-4c62-8b9d-0a667016ef1b">
      <ID>KPI 1</ID>
      <Name>Ausentismo</Name>
      <Value>[Measures].[Tasa Ausentismo]</Value>
      <Goal>0.10</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("Ausentismo")) THEN NULL
    WHEN KPIValue("Ausentismo") &lt;= KPIGoal("Ausentismo") THEN 1
    WHEN KPIValue("Ausentismo") &lt;= 0.15 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty(([Measures].[Tasa Ausentismo], [Tiempo].[Calendario].CurrentMember.PrevMember)) THEN 0
    WHEN KPIValue("Ausentismo") &lt; ([Measures].[Tasa Ausentismo], [Tiempo].[Calendario].CurrentMember.PrevMember) THEN 1
    WHEN KPIValue("Ausentismo") &gt; ([Measures].[Tasa Ausentismo], [Tiempo].[Calendario].CurrentMember.PrevMember) THEN -1
    ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="9a7476c1-8058-4396-a25d-4f0bf1ed1ab8">
      <ID>KPI</ID>
      <Name>Asistencia</Name>
      <Value>[Measures].[Tasa Asistencia]</Value>
      <Goal>0.75</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("Asistencia")) THEN NULL
    WHEN KPIValue("Asistencia") &gt;= KPIGoal("Asistencia") THEN 1
    WHEN KPIValue("Asistencia") &gt;= 0.65 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty(([Measures].[Tasa Asistencia], [Tiempo].[Calendario].CurrentMember.PrevMember)) THEN 0
    WHEN KPIValue("Asistencia") &gt; ([Measures].[Tasa Asistencia], [Tiempo].[Calendario].CurrentMember.PrevMember) THEN 1
    WHEN KPIValue("Asistencia") &lt; ([Measures].[Tasa Asistencia], [Tiempo].[Calendario].CurrentMember.PrevMember) THEN -1
    ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="d0c3dfbc-0ec2-4d43-a82a-af90a784e29b">
      <ID>KPI 2</ID>
      <Name>Crecimiento Demanda</Name>
      <Value>[Measures].[Variacion Interanual]</Value>
      <Goal>0.10</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("Crecimiento Demanda")) THEN NULL
    WHEN KPIValue("Crecimiento Demanda") &gt;= KPIGoal("Crecimiento Demanda") THEN 1
    WHEN KPIValue("Crecimiento Demanda") &gt;= 0 THEN 0
    ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="4d18ed07-23ea-4177-b301-687837293b54">
      <ID>KPI 3</ID>
      <Name>Cancelacion</Name>
      <Value>[Measures].[Tasa Cancelacion]</Value>
      <Goal>0.12</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("Cancelacion")) THEN NULL
    WHEN KPIValue("Cancelacion") &lt;= KPIGoal("Cancelacion") THEN 1
    WHEN KPIValue("Cancelacion") &lt;= 0.18 THEN 0
    ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>