            <component
              refId="Package\Cargar Fact_Turno\Turnos (Clinica)"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="Turnos del OLTP con la fecha y la hora ya convertidas a las claves de Tiempo y Horario"
              name="Turnos (Clinica)"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT t.id                                                         AS id_turno,
       CONVERT(INT, CONVERT(CHAR(8), t.fecha, 112))                 AS sk_tiempo,      -- AAAAMMDD
       DATEPART(HOUR, t.hora) * 100 + (DATEPART(MINUTE, t.hora) / 30) * 30 AS sk_horario, -- HHMM a 30'
       t.id_paciente,
       t.id_profesional,
       t.id_especialidad,
       t.estado                                                     AS sk_estado,
       1                                                            AS cantidad_turnos,
       CASE WHEN t.estado = 2 THEN 1 ELSE 0 END                     AS turno_atendido,
       CASE WHEN t.estado = 3 THEN 1 ELSE 0 END                     AS turno_cancelado,
       CASE WHEN t.estado = 4 THEN 1 ELSE 0 END                     AS turno_ausente,
       CASE WHEN t.estado = 1 THEN 1 ELSE 0 END                     AS turno_pendiente,
       DATEDIFF(YEAR, p.fechaNacimiento, t.fecha)
         - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.fechaNacimiento, t.fecha), p.fechaNacimiento) &gt; t.fecha
                THEN 1 ELSE 0 END                                   AS edad_paciente
FROM dbo.Turno t
JOIN dbo.Paciente p ON p.id = t.id_paciente</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\Cargar Fact_Turno\Turnos (Clinica).Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[Clinica (OLTP)]"
