  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Cargar Dim_Especialidad"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{1612C1BA-03A7-49CC-A48B-9CB549664EC8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cargar Dim_Especialidad"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F12E87DC-C46A-43D0-A428-B9290281C36A}"
          SQLTask:SqlStatementSource="/* Dim_Especialidad: SCD tipo 1 */&#xA;MERGE dbo.Dim_Especialidad AS d&#xA;USING (SELECT id, nombre FROM Clinica.dbo.Especialidad) AS s&#xA;ON d.id_especialidad = s.id&#xA;WHEN MATCHED THEN UPDATE SET d.nombre_especialidad = s.nombre&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (id_especialidad, nombre_especialidad) VALUES (s.id, s.nombre);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Cargar Dim_Paciente"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{F27B82F2-A54D-45D1-B306-AEC103786784}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cargar Dim_Paciente"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F12E87DC-C46A-43D0-A428-B9290281C36A}"
          SQLTask:SqlStatementSource="/* Dim_Paciente: SCD tipo 1 (inserta nuevos, actualiza cambios) */&#xA;DECLARE @Hoy DATE = CAST(GETDATE() AS DATE);&#xA;&#xA;MERGE dbo.Dim_Paciente AS d&#xA;USING (&#xA;    SELECT p.id,&#xA;           p.apellido + ', ' + p.nombre AS nombre_completo,&#xA;           ISNULL(NULLIF(LTRIM(RTRIM(p.sexo)), ''), 'Sin dato') AS sexo,&#xA;           p.fechaNacimiento,&#xA;           e.edad,&#xA;           CASE WHEN e.edad &lt;= 12 THEN '0-12 Niños'&#xA;                WHEN e.edad &lt;= 17 THEN '13-17 Adolescentes'&#xA;                WHEN e.edad &lt;= 35 THEN '18-35 Jóvenes'&#xA;                WHEN e.edad &lt;= 59 THEN '36-59 Adultos'&#xA;                ELSE '60+ Adultos mayores' END AS rango_etario,&#xA;           ISNULL(NULLIF(LTRIM(RTRIM(p.obra_social)), ''), 'Sin obra social') AS obra_social,&#xA;           CASE WHEN CHARINDEX(',', p.direccion) &gt; 0&#xA;                THEN LTRIM(RTRIM(SUBSTRING(p.direccion, CHARINDEX(',', p.direccion) + 1, 255)))&#xA;                ELSE 'Sin dato' END AS localidad&#xA;    FROM Clinica.dbo.Paciente p&#xA;    CROSS APPLY (SELECT DATEDIFF(YEAR, p.fechaNacimiento, @Hoy)&#xA;                      - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.fechaNacimiento, @Hoy), p.fechaNacimiento) &gt; @Hoy&#xA;                             THEN 1 ELSE 0 END AS edad) e&#xA;) AS s&#xA;ON d.id_paciente = s.id&#xA;WHEN MATCHED THEN UPDATE SET&#xA;    d.nombre_completo = s.nombre_completo, d.sexo = s.sexo,&#xA;    d.fecha_nacimiento = s.fechaNacimiento, d.edad = s.edad, d.rango_etario = s.rango_etario,&#xA;    d.obra_social = s.obra_social, d.localidad = s.localidad&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (id_paciente, nombre_completo, sexo, fecha_nacimiento, edad, rango_etario, obra_social, localidad)&#xA;    VALUES (s.id, s.nombre_completo, s.sexo, s.fechaNacimiento, s.edad, s.rango_etario, s.obra_social, s.localidad);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Cargar Dim_Profesional"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{77F12FAF-615E-4C0E-A6D0-16119AB17A26}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cargar Dim_Profesional"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F12E87DC-C46A-43D0-A428-B9290281C36A}"
          SQLTask:SqlStatementSource="/* Dim_Profesional: SCD tipo 1 */&#xA;MERGE dbo.Dim_Profesional AS d&#xA;USING (&#xA;    SELECT pr.ID, pr.apellido + ', ' + pr.nombre AS nombre_completo&#xA;    FROM Clinica.dbo.Profesional pr&#xA;) AS s&#xA;ON d.id_profesional = s.ID&#xA;WHEN MATCHED THEN UPDATE SET&#xA;    d.nombre_completo = s.nombre_completo&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (id_profesional, nombre_completo)&#xA;    VALUES (s.ID, s.nombre_completo);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
