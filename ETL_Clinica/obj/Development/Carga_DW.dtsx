                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Cargar Fact_Turno\Turnos (Clinica).Outputs[OLE DB Source Output].ExternalColumns[sk_tiempo]"
